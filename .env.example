# ==============================================================================
# ENVIRONMENT VARIABLES & DEPLOYMENT CONFIGURATION
# ==============================================================================

# 1. Gemini AI API Key (Required for AI Chat, Strategic Recommendations, and Vision OCR)
# In AI Studio, this is automatically injected.
# On Vercel / Docker / VPS, get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_google_gemini_api_key_here"

# 2. Application URL & Port
APP_URL="https://your-domain.com"
PORT=3000
NODE_ENV="production"

# 3. Universal PostgreSQL Database Connection
# Supported by Vercel Postgres, Neon, Supabase, Railway, Render, AWS RDS:
DATABASE_URL="postgres://username:password@host:5432/database_name?sslmode=require"

# Alternatively, configure individual Cloud SQL / self-hosted parameters:
SQL_HOST="127.0.0.1"
SQL_PORT=5432
SQL_USER="postgres"
SQL_PASSWORD="your_password"
SQL_DB_NAME="webaudit"
SQL_SSL="false"
